import (Mime) from "lib.zen"

Mime m

screen(m.type("index.html"))
screen(m.type("page.htm"))
screen(m.type("style.css"))
screen(m.type("app.js"))
screen(m.type("module.mjs"))
screen(m.type("data.json"))
screen(m.type("feed.xml"))
screen(m.type("notes.txt"))
screen(m.type("table.csv"))
screen(m.type("readme.md"))
screen(m.type("icon.svg"))
screen(m.type("photo.png"))
screen(m.type("photo.jpg"))
screen(m.type("photo.jpeg"))
screen(m.type("anim.gif"))
screen(m.type("pic.webp"))
screen(m.type("pic.avif"))
screen(m.type("favicon.ico"))
screen(m.type("old.bmp"))
screen(m.type("song.mp3"))
screen(m.type("sound.wav"))
screen(m.type("audio.ogg"))
screen(m.type("clip.mp4"))
screen(m.type("clip.webm"))
screen(m.type("clip.avi"))
screen(m.type("doc.pdf"))
screen(m.type("archive.zip"))
screen(m.type("archive.gz"))
screen(m.type("archive.tar"))
screen(m.type("module.wasm"))
screen(m.type("font.woff"))
screen(m.type("font.woff2"))
screen(m.type("font.ttf"))
screen(m.type("font.otf"))
screen(m.type("unknown.xyz"))

// case-insensitivity check
screen(m.type("IMAGE.PNG"))
screen(m.type("Style.CSS"))
screen(m.type("Archive.ZIP"))

// no extension
screen(m.type("Makefile"))

// isText / isBinary
screen(m.isText("index.html"))
screen(m.isText("photo.png"))
screen(m.isBinary("index.html"))
screen(m.isBinary("photo.png"))
screen(m.isText("icon.svg"))
screen(m.isBinary("icon.svg"))
